{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "HealthChecks": {
    "AuthApi": "<AUTH_API_URL>",
    "AccountsApi": "<ACCOUNTS_API_URL>",
    "NomenclatureApi": "<NOMENCLATURE_API_URL>",
    "EventLogApi": "<EVENTLOG_API_URL>",
    "JournalApi": "<JOURNAL_API_URL>",
    "InvoicesApi": "<INVOICES_API_URL>",
    "PeriodsApi": "<PERIODS_API_URL>"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:6000"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        }
      },
      "users-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/users/{**catch-all}"
        }
      },
      "roles-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/roles/{**catch-all}"
        }
      },
      "permissions-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/v1/permissions/{**catch-all}"
        }
      },
      "accounts-route": {
        "ClusterId": "accounts-cluster",
        "Match": {
          "Path": "/api/v1/accounts/{**catch-all}"
        }
      },
      "currencies-route": {
        "ClusterId": "nomenclature-cluster",
        "Match": {
          "Path": "/api/v1/currencies/{**catch-all}"
        }
      },
      "exchange-rates-route": {
        "ClusterId": "nomenclature-cluster",
        "Match": {
          "Path": "/api/v1/exchange-rates/{**catch-all}"
        }
      },
      "countries-route": {
        "ClusterId": "nomenclature-cluster",
        "Match": {
          "Path": "/api/v1/countries/{**catch-all}"
        }
      },
      "states-route": {
        "ClusterId": "nomenclature-cluster",
        "Match": {
          "Path": "/api/v1/states/{**catch-all}"
        }
      },
      "cities-route": {
        "ClusterId": "nomenclature-cluster",
        "Match": {
          "Path": "/api/v1/cities/{**catch-all}"
        }
      },
      "events-route": {
        "ClusterId": "eventlog-cluster",
        "Match": {
          "Path": "/api/v1/events/{**catch-all}"
        }
      },
      "journal-entries-route": {
        "ClusterId": "journal-cluster",
        "Match": {
          "Path": "/api/v1/journal-entries/{**catch-all}"
        }
      },
      "trial-balance-route": {
        "ClusterId": "journal-cluster",
        "Match": {
          "Path": "/api/v1/trial-balance/{**catch-all}"
        }
      },
      "general-ledger-route": {
        "ClusterId": "journal-cluster",
        "Match": {
          "Path": "/api/v1/general-ledger/{**catch-all}"
        }
      },
      "posting-rules-route": {
        "ClusterId": "journal-cluster",
        "Match": {
          "Path": "/api/v1/posting-rules/{**catch-all}"
        }
      },
      "posting-route": {
        "ClusterId": "journal-cluster",
        "Match": {
          "Path": "/api/v1/posting/{**catch-all}"
        }
      },
      "invoices-route": {
        "ClusterId": "invoices-cluster",
        "Match": {
          "Path": "/api/v1/invoices/{**catch-all}"
        }
      },
      "periods-route": {
        "ClusterId": "periods-cluster",
        "Match": {
          "Path": "/api/v1/periods/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "auth-api": {
            "Address": "<AUTH_API_URL>"
          }
        }
      },
      "accounts-cluster": {
        "Destinations": {
          "accounts-api": {
            "Address": "<ACCOUNTS_API_URL>"
          }
        }
      },
      "nomenclature-cluster": {
        "Destinations": {
          "nomenclature-api": {
            "Address": "<NOMENCLATURE_API_URL>"
          }
        }
      },
      "eventlog-cluster": {
        "Destinations": {
          "eventlog-api": {
            "Address": "<EVENTLOG_API_URL>"
          }
        }
      },
      "journal-cluster": {
        "Destinations": {
          "journal-api": {
            "Address": "<JOURNAL_API_URL>"
          }
        }
      },
      "invoices-cluster": {
        "Destinations": {
          "invoices-api": {
            "Address": "<INVOICES_API_URL>"
          }
        }
      },
      "periods-cluster": {
        "Destinations": {
          "periods-api": {
            "Address": "<PERIODS_API_URL>"
          }
        }
      }
    }
  }
}
