<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Finance.Infrastructure.Messaging</PackageId>
    <Description>Resilient event publisher/consumer layer for Finance microservices (SDD-INFRA-006): MassTransit with the EF Core transactional outbox, RabbitMQ transport, retry/dead-letter policy, and a Redis-backed IdempotencyFilter that reuses the IConnectionMultiplexer owned by Finance.Infrastructure.Caching. Ships the AddFinanceMessageBus&lt;TDbContext&gt; DI bundle and the UseFinanceIdempotency configurator. Outbox tables and concrete domain events are owned per service later.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MassTransit" Version="8.3.0" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.3.0" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Finance.Common\Finance.Common.csproj" />
    <ProjectReference Include="..\..\..\Finance.ServiceModel\Finance.ServiceModel.csproj" />
    <ProjectReference Include="..\..\Caching\Finance.Infrastructure.Caching\Finance.Infrastructure.Caching.csproj" />
  </ItemGroup>

</Project>
