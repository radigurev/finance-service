<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github" value="https://nuget.pkg.github.com/radigurev/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_PACKAGES_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github">
      <package pattern="Warehouse.Auth.*" />
      <package pattern="Warehouse.Common" />
      <package pattern="Warehouse.ServiceModel" />
      <package pattern="Warehouse.Correlation" />
      <package pattern="Warehouse.Infrastructure" />
      <package pattern="Finance.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
